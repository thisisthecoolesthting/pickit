---
import { CATEGORY_PAGES } from '@/lib/categories';

const cats = CATEGORY_PAGES.map(c => ({
  id: c.slug,
  emoji: c.emoji,
  name: c.name,
  desc: c.description.split('.')[0] + '.',
  href: `/${c.slug}`,
}));
---
<section id="categories" class="mt-12">
  <h2 class="text-3xl md:text-4xl font-bold text-ink text-center mb-2">10 silly categories</h2>
  <p class="text-center text-ink/70 mb-6 max-w-xl mx-auto">
    Play a random mix on the <a href="/" class="font-bold underline">home game</a>, or jump straight into a category.
  </p>
  <div class="grid gap-4 md:grid-cols-2">
    {cats.map((c, i) => (
      <a href={c.href} class={`block rounded-2xl border-4 border-ink p-4 shadow-chunky-sm bg-cream hover:bg-white transition-colors ${i % 4 === 0 ? '-rotate-1' : i % 4 === 1 ? 'rotate-1' : i % 4 === 2 ? '-rotate-2' : 'rotate-2'}`}>
        <div class="flex items-start gap-3">
          <div class="text-4xl md:text-5xl flex-shrink-0 sticker-emoji-sm" aria-hidden="true">{c.emoji}</div>
          <div class="min-w-0">
            <h3 class="font-bold text-lg md:text-xl text-ink mb-1">{c.name} →</h3>
            <p class="text-sm text-ink/70 leading-snug">{c.desc}</p>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
