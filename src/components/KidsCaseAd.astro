---
interface Case {
  id: string;
  name: string;
  lean: string;
  imgUrl: string;
}
interface Props {
  cases: Case[];                              // 4-5 case thumbnails for this ad
  headline: string;
  promoCode?: string;
  ctaText?: string;
  ctaHref: string;
  tilt?: '-1' | '0' | '1' | '2';
  bg?: 'lime' | 'pink' | 'cyan' | 'sun';
}
const {
  cases,
  headline,
  promoCode = 'PICKIT15',
  ctaText = 'Shop the collection →',
  ctaHref,
  tilt = '0',
  bg = 'lime',
} = Astro.props;
const tiltClass = tilt === '0' ? '' : tilt === '-1' ? '-rotate-1' : tilt === '1' ? 'rotate-1' : 'rotate-2';
const bgClass: Record<string, string> = {
  lime: 'bg-lime',
  pink: 'bg-pink',
  cyan: 'bg-cyan',
  sun:  'bg-sun',
};
---
<aside class={`relative rounded-3xl border-4 border-ink ${bgClass[bg]} p-4 md:p-5 shadow-chunky ${tiltClass}`}>
  <!-- "AD" badge -->
  <div class="absolute -top-3 -left-3 rounded-full bg-sun border-3 border-ink px-3 py-1 text-xs font-bold text-ink shadow-chunky-sm">
    AD
  </div>

  <!-- POW! comic burst -->
  <div class="absolute -top-4 -right-2 text-3xl rotate-12 select-none animate-wobble" aria-hidden="true">💥</div>

  <!-- Headline -->
  <h3 class="font-bold text-lg md:text-xl leading-tight text-ink mb-3 pr-4">{headline}</h3>

  <!-- 5-thumbnail row of real case mockups -->
  <a href={ctaHref} rel="sponsored nofollow noopener" target="_blank"
     class="block mb-3 rounded-2xl border-3 border-ink bg-cream p-2 hover:bg-white transition-colors">
    <div class="grid grid-cols-5 gap-1 md:gap-2">
      {cases.map((c, i) => (
        <div class={`relative aspect-[3/4] overflow-hidden rounded-lg border-2 border-ink ${i % 2 === 0 ? '-rotate-2' : 'rotate-2'}`}>
          <img
            src={c.imgUrl}
            alt={c.name}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
      ))}
    </div>
  </a>

  <!-- Promo code + CTA row -->
  <div class="flex items-center gap-2 flex-wrap">
    {promoCode && (
      <div class="rounded-full bg-pink border-2 border-ink px-3 py-1 text-xs font-bold text-cream shadow-chunky-sm">
        Code: {promoCode}
      </div>
    )}
    <a
      href={ctaHref}
      rel="sponsored nofollow noopener"
      target="_blank"
      class="flex-1 min-w-0 rounded-full bg-cyan hover:bg-cyan-deep border-3 border-ink px-4 py-2 text-center text-sm font-bold text-ink shadow-chunky-sm transition-transform active:translate-x-1 active:translate-y-1"
    >
      {ctaText}
    </a>
  </div>
</aside>
