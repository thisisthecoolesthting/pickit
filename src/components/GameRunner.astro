---
// GameRunner: vanilla JS island.
// Pulls the full 100-question pool from the page's data attribute,
// shuffles, takes 20, drives the A/B flow.
interface Props {
  questions: { id: string; a: string; a_emoji: string; b: string; b_emoji: string }[];
  perGame?: number;
}
const { questions, perGame = 20 } = Astro.props;
---
<div
  id="pickit-game"
  data-questions={JSON.stringify(questions)}
  data-per-game={perGame}
  class="mt-6"
>
  <div id="pickit-loading" class="text-center text-2xl text-ink/60">Loading the silliness…</div>
</div>

<script>
  type Q = { id: string; a: string; a_emoji: string; b: string; b_emoji: string };

  const root = document.getElementById('pickit-game')!;
  const all: Q[] = JSON.parse(root.dataset.questions || '[]');
  const perGame = parseInt(root.dataset.perGame || '20', 10);

  // Fisher-Yates shuffle
  function shuffle<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  const game: Q[] = shuffle(all).slice(0, perGame);
  let idx = 0;
  const picks: ('a' | 'b')[] = [];

  function renderQuestion() {
    const q = game[idx];
    root.innerHTML = `
      <div class="mb-4 flex items-center justify-between text-sm md:text-base font-bold text-ink/70">
        <span>Question ${idx + 1} of ${game.length}</span>
        <span class="rounded-full bg-sun px-3 py-1 border-2 border-ink shadow-chunky-sm animate-wobble">PICKIT</span>
      </div>
      <h2 class="mb-6 text-center text-2xl md:text-3xl font-bold text-ink">
        <span class="inline-block animate-bounce-soft mr-1" aria-hidden="true">🤔</span>
        Would you rather…
      </h2>
      <div class="relative flex items-stretch gap-2 md:gap-3 animate-pop-in">
        <button data-side="a" class="tile flex-1 min-w-0 rounded-2xl md:rounded-3xl border-4 border-ink bg-gradient-to-br from-pink to-pink-deep px-2 py-4 md:px-6 md:py-8 text-center shadow-chunky -rotate-1 transition-transform active:translate-x-1 active:translate-y-1">
          <div class="mb-2 md:mb-3 text-5xl sm:text-6xl md:text-8xl leading-none select-none sticker-emoji" aria-hidden="true">${q.a_emoji}</div>
          <div class="text-xs sm:text-sm md:text-xl font-bold text-ink leading-tight break-words hyphens-auto">${escapeHtml(q.a)}</div>
        </button>

        <!-- VS starburst badge, centered between the tiles -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 pointer-events-none animate-wobble">
          <div class="relative">
            <svg class="w-14 h-14 md:w-24 md:h-24 drop-shadow-[3px_3px_0_rgba(26,26,26,0.85)]" viewBox="0 0 100 100" aria-hidden="true">
              <polygon points="50,2 61,34 95,35 67,55 78,92 50,72 22,92 33,55 5,35 39,34"
                       fill="#FFD93D" stroke="#1A1A1A" stroke-width="5" stroke-linejoin="round"/>
            </svg>
            <div class="absolute inset-0 flex items-center justify-center text-base md:text-2xl font-extrabold text-ink select-none">VS</div>
          </div>
        </div>

        <button data-side="b" class="tile flex-1 min-w-0 rounded-2xl md:rounded-3xl border-4 border-ink bg-gradient-to-br from-cyan to-cyan-deep px-2 py-4 md:px-6 md:py-8 text-center shadow-chunky rotate-1 transition-transform active:translate-x-1 active:translate-y-1">
          <div class="mb-2 md:mb-3 text-5xl sm:text-6xl md:text-8xl leading-none select-none sticker-emoji" aria-hidden="true">${q.b_emoji}</div>
          <div class="text-xs sm:text-sm md:text-xl font-bold text-ink leading-tight break-words hyphens-auto">${escapeHtml(q.b)}</div>
        </button>
      </div>
    `;
    root.querySelectorAll<HTMLButtonElement>('button[data-side]').forEach(btn => {
      btn.addEventListener('click', () => choose(btn.dataset.side as 'a' | 'b'));
    });
  }

  function choose(side: 'a' | 'b') {
    picks.push(side);
    idx++;
    if (idx >= game.length) {
      renderSummary();
    } else {
      renderQuestion();
    }
  }

  function renderSummary() {
    const aCount = picks.filter(p => p === 'a').length;
    const bCount = picks.filter(p => p === 'b').length;
    root.innerHTML = `
      <div class="text-center py-10 animate-pop-in">
        <div class="text-7xl md:text-8xl mb-4 sticker-emoji animate-wobble inline-block">🎉</div>
        <h2 class="text-3xl md:text-4xl font-bold mb-3 text-ink">All done!</h2>
        <p class="text-lg md:text-xl text-ink/80 mb-8">You picked <span class="font-bold text-pink-deep">A: ${aCount}</span> and <span class="font-bold text-cyan-deep">B: ${bCount}</span> out of ${game.length} silly choices.</p>
        <button id="pickit-replay" class="rounded-full bg-lime hover:bg-lime-deep border-4 border-ink px-8 py-4 text-2xl font-bold text-ink shadow-chunky transition-transform active:translate-x-1 active:translate-y-1 active:shadow-chunky-sm">
          🔁 Play another!
        </button>
      </div>
    `;
    document.getElementById('pickit-replay')!.addEventListener('click', () => location.reload());
    burstConfetti();
  }

  function burstConfetti() {
    const pieces = ['🎉','✨','⭐','🌈','🎊','💫','🎈','🍭'];
    const count = 36;
    for (let i = 0; i < count; i++) {
      const el = document.createElement('div');
      el.className = 'confetti';
      el.textContent = pieces[Math.floor(Math.random() * pieces.length)]!;
      el.style.left = `${Math.random() * 100}vw`;
      el.style.animationDelay = `${Math.random() * 0.8}s`;
      el.style.animationDuration = `${2.5 + Math.random() * 1.5}s`;
      el.style.fontSize = `${22 + Math.floor(Math.random() * 18)}px`;
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 4500);
    }
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  if (all.length === 0) {
    root.innerHTML = '<div class="text-center text-2xl text-ink/60">No questions loaded yet. Check back soon!</div>';
  } else {
    renderQuestion();
  }
</script>
