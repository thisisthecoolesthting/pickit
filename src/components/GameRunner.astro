---
interface CaseItem {
  id: string;
  name: string;
  lean: string;
  imgUrl: string;
}
interface Props {
  questions: { id: string; a: string; a_emoji: string; b: string; b_emoji: string }[];
  perGame?: number;
  featuredCases?: CaseItem[];
  shopHref?: string;
  gameId?: string;
  caseBreakEvery?: number;
}
const {
  questions,
  perGame = 20,
  featuredCases = [],
  shopHref = 'https://phonecasesforkids.com?utm_source=pickit&utm_medium=ad&utm_campaign=post_game',
  gameId = 'main',
  caseBreakEvery = 7,
} = Astro.props;
---
<div
  id="pickit-game"
  data-questions={JSON.stringify(questions)}
  data-per-game={perGame}
  data-cases={JSON.stringify(featuredCases)}
  data-shop-href={shopHref}
  data-game-id={gameId}
  data-case-break={caseBreakEvery}
  class="mt-2"
>
  <div id="pickit-loading" class="text-center text-2xl text-ink/60">Loading the silliness…</div>
</div>

<script>
  type Q = { id: string; a: string; a_emoji: string; b: string; b_emoji: string };
  type CaseItem = { id: string; name: string; lean: string; imgUrl: string };

  const root = document.getElementById('pickit-game')!;
  const all: Q[] = JSON.parse(root.dataset.questions || '[]');
  const perGame = parseInt(root.dataset.perGame || '20', 10);
  const featuredCases: CaseItem[] = JSON.parse(root.dataset.cases || '[]');
    const shopHref = root.dataset.shopHref || 'https://phonecasesforkids.com';
    const caseBreakEvery = parseInt(root.dataset.caseBreak || '7', 10);
    const utmSource = window.location.hostname.replace(/^www\./, '') === 'picksite.online' ? 'picksite' : 'pickit';
    function withUtm(href: string) {
      try {
        const u = new URL(href);
        u.searchParams.set('utm_source', utmSource);
        return u.toString();
      } catch { return href; }
    }
    const shopHrefLive = withUtm(shopHref);

  function shuffle<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  const game: Q[] = shuffle(all).slice(0, perGame);
  let idx = 0;
  const picks: ('a' | 'b')[] = [];
  let score = 0;
  let streak = 0;
  let lastSide: 'a' | 'b' | null = null;
  let caseBreakIdx = 0;

  const REACTIONS = [
    { e: '🔥', t: 'Iconic!' },        { e: '💯', t: 'No notes.' },      { e: '👀', t: 'Bold move.' },
    { e: '🤯', t: 'Wild choice!' },   { e: '🌟', t: 'Classic taste.' }, { e: '🎉', t: 'Perfection!' },
    { e: '💪', t: 'Power move.' },    { e: '🚀', t: 'Big energy.' },    { e: '🧠', t: 'Galaxy brain.' },
    { e: '🎯', t: 'Locked in.' },     { e: '💎', t: 'Rare pick!' },     { e: '✨', t: 'Sparkle vibes.' },
    { e: '🦄', t: 'Unbeatable.' },    { e: '🌈', t: 'Vibey.' },         { e: '🥳', t: 'Yes yes yes.' },
    { e: '👑', t: 'Royal pick.' },    { e: '🍕', t: 'Slice of greatness.' },
    { e: '🐲', t: 'Dragon energy.' }, { e: '🎲', t: 'Roll the dice!' }, { e: '🌮', t: 'Spicy.' },
    { e: '🏆', t: 'Champion.' },      { e: '🎪', t: 'Showstopper.' },   { e: '🎨', t: 'Picasso pick.' },
    { e: '🪄', t: 'Magic moment.' },  { e: '⚡', t: 'Lightning fast!' },
    { e: '🍭', t: 'Sweet pick.' },    { e: '😎', t: 'Cool kid alert.' },
    { e: '🎈', t: 'Floating on it.' },{ e: '🦖', t: 'Roar-some.' },     { e: '🌶️', t: 'Spicy take.' },
    { e: '🤔', t: 'Hmm... cool.' },   { e: '😤', t: 'Big mood.' },      { e: '🌟', t: 'A+ vibe.' },
    { e: '🪩', t: 'Disco pick!' },    { e: '🎸', t: 'Rockstar move.' }, { e: '🍦', t: 'Sweet sweet.' },
  ];
  const POINTS = [5, 10, 10, 15, 15, 20, 25, 25, 30, 40, 50, 75];
  const MEGA = 999;
  const MEGA_CHANCE = 0.04;
  const STREAK_BONUS_MIN = 3;
  const STREAK_PHRASES: Record<number,string> = {
    3: '🔥 STREAK x3!', 4: '🔥🔥 STREAK x4!', 5: '🔥🔥🔥 ON FIRE!',
    6: '👑 RUTHLESS x6!', 7: '💎 UNSTOPPABLE!',
  };

  function renderQuestion() {
    const q = game[idx];
    root.innerHTML = `
      <div class="mb-4 flex items-center justify-between text-sm md:text-base font-bold text-ink/70 gap-2">
        <span>Question ${idx + 1} of ${game.length}</span>
        <span id="pickit-score" class="pickit-score rounded-full bg-lime border-2 border-ink px-3 py-1 shadow-chunky-sm text-ink">
          🌟 ${score} silly pts
        </span>
      </div>
      <h2 class="mb-6 text-center text-2xl md:text-3xl font-bold text-ink">
        <span class="inline-block animate-bounce-soft mr-1" aria-hidden="true">🤔</span>
        Would you rather…
      </h2>
      <div class="relative flex flex-col md:flex-row items-stretch gap-3 md:gap-3 animate-pop-in">
        <button data-side="a" class="tile flex-1 min-w-0 rounded-2xl md:rounded-3xl border-4 border-ink bg-gradient-to-br from-pink to-pink-deep px-4 py-6 md:px-6 md:py-8 text-center shadow-chunky -rotate-1 transition-transform active:translate-x-1 active:translate-y-1">
          <div class="mb-2 md:mb-3 text-7xl md:text-8xl leading-none select-none sticker-emoji" aria-hidden="true">${q.a_emoji}</div>
          <div class="text-base md:text-xl font-bold text-ink leading-tight break-words hyphens-auto">${escapeHtml(q.a)}</div>
        </button>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 pointer-events-none">
          <div class="relative animate-wobble">
            <svg class="w-16 h-16 md:w-24 md:h-24 drop-shadow-[3px_3px_0_rgba(26,26,26,0.85)]" viewBox="0 0 100 100" aria-hidden="true">
              <polygon points="50,2 61,34 95,35 67,55 78,92 50,72 22,92 33,55 5,35 39,34"
                       fill="#FFD93D" stroke="#1A1A1A" stroke-width="5" stroke-linejoin="round"/>
            </svg>
            <div class="absolute inset-0 flex items-center justify-center text-xl md:text-2xl font-extrabold text-ink select-none">VS</div>
          </div>
        </div>
        <button data-side="b" class="tile flex-1 min-w-0 rounded-2xl md:rounded-3xl border-4 border-ink bg-gradient-to-br from-cyan to-cyan-deep px-4 py-6 md:px-6 md:py-8 text-center shadow-chunky rotate-1 transition-transform active:translate-x-1 active:translate-y-1">
          <div class="mb-2 md:mb-3 text-7xl md:text-8xl leading-none select-none sticker-emoji" aria-hidden="true">${q.b_emoji}</div>
          <div class="text-base md:text-xl font-bold text-ink leading-tight break-words hyphens-auto">${escapeHtml(q.b)}</div>
        </button>
      </div>
    `;
    root.querySelectorAll<HTMLButtonElement>('button[data-side]').forEach(btn => {
      btn.addEventListener('click', () => choose(btn.dataset.side as 'a' | 'b'));
    });
  }

  function renderCaseBreak(onContinue: () => void) {
    const c = featuredCases[caseBreakIdx % Math.max(featuredCases.length, 1)];
    caseBreakIdx++;
    const imgs = featuredCases.slice(0, 4).map(x =>
      `<img src="${x.imgUrl}" alt="${escapeHtml(x.name)}" class="h-16 md:h-20 w-auto drop-shadow-[2px_2px_0_rgba(26,26,26,0.85)]" />`
    ).join('');

    root.innerHTML = `
      <div class="text-center py-6 animate-pop-in rounded-3xl border-4 border-ink bg-sun p-5 shadow-chunky">
        <div class="inline-block rounded-full bg-pink border-2 border-ink px-3 py-1 text-xs font-bold mb-3">AD · Case break!</div>
        <h2 class="text-2xl md:text-3xl font-bold text-ink mb-2">📱 Pick a case that matches your vibe</h2>
        <p class="text-ink/80 mb-4 text-sm md:text-base">Tough kid cases from our friends at Phone Cases For Kids. Code <strong>PICKIT15</strong> = 15% off.</p>
        <div class="flex justify-center items-end gap-2 mb-4 flex-wrap">${imgs}</div>
        ${c ? `<p class="text-sm font-bold text-ink/70 mb-4">Spotlight: ${escapeHtml(c.name)}</p>` : ''}
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="${shopHrefLive}" rel="sponsored nofollow noopener" target="_blank"
             class="rounded-full bg-pink hover:bg-pink-deep border-4 border-ink px-6 py-3 text-lg font-bold text-ink shadow-chunky">
            Find my case →
          </a>
          <button id="pickit-skip-break" class="rounded-full bg-cream hover:bg-white border-4 border-ink px-6 py-3 text-lg font-bold text-ink shadow-chunky-sm">
            Keep playing →
          </button>
        </div>
      </div>
    `;
    document.getElementById('pickit-skip-break')!.addEventListener('click', onContinue);
  }

  function choose(side: 'a' | 'b') {
    picks.push(side);
    if (side === lastSide) streak++; else streak = 1;
    lastSide = side;
    showReaction(side);

    setTimeout(() => {
      idx++;
      if (idx >= game.length) renderSummary();
      else if (caseBreakEvery > 0 && idx > 0 && idx % caseBreakEvery === 0) {
        renderCaseBreak(() => renderQuestion());
      } else renderQuestion();
    }, 700);
  }

  function showReaction(side: 'a' | 'b') {
    const r = REACTIONS[Math.floor(Math.random() * REACTIONS.length)]!;
    const mega = Math.random() < MEGA_CHANCE;
    const bonus = mega ? MEGA : POINTS[Math.floor(Math.random() * POINTS.length)]!;
    score += bonus;
    const streakLine = streak >= STREAK_BONUS_MIN
      ? (STREAK_PHRASES[Math.min(streak, 7)] || `🔥 STREAK x${streak}!`) : '';

    const el = document.createElement('div');
    el.className = 'pickit-reaction';
    el.innerHTML = `
      <div class="r-emoji">${r.e}</div>
      <div class="r-text">${r.t}</div>
      <div class="r-bonus ${mega ? 'r-mega' : ''}">+${bonus}${mega ? ' MEGA!' : ' pts'}</div>
      ${streakLine ? `<div class="r-text" style="margin-top:8px;background:#FF4D8F;color:#fff;">${streakLine}</div>` : ''}
    `;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 950);

    const chip = document.getElementById('pickit-score');
    if (chip) {
      chip.textContent = `🌟 ${score} silly pts`;
      chip.classList.remove('bump');
      void chip.offsetWidth;
      chip.classList.add('bump');
    }
  }

  function renderSummary() {
    const aCount = picks.filter(p => p === 'a').length;
    const bCount = picks.filter(p => p === 'b').length;
    let rank: { emoji: string; title: string; tagline: string; };
    if (score >= 1500)      rank = { emoji: '👑', title: 'PICKIT LEGEND', tagline: 'Top 0.1% of kid choosers.' };
    else if (score >= 1000) rank = { emoji: '🦄', title: 'UNICORN TIER',  tagline: 'Top 3% — extremely rare.' };
    else if (score >= 700)  rank = { emoji: '🔥', title: 'ON FIRE',       tagline: 'Top 10%. Iconic.' };
    else if (score >= 400)  rank = { emoji: '⭐', title: 'STAR PICKER',    tagline: 'Top 25%. Quality choices.' };
    else if (score >= 200)  rank = { emoji: '🎯', title: 'SOLID PICKER',   tagline: 'Top 50%. Locked in.' };
    else                    rank = { emoji: '🌱', title: 'SPROUT PICKER', tagline: 'Warmin’ up!' };

    const caseGrid = featuredCases.slice(0, 6).map(c =>
      `<img src="${c.imgUrl}" alt="${escapeHtml(c.name)}" title="${escapeHtml(c.name)}"
            class="h-20 md:h-24 w-auto drop-shadow-[3px_3px_0_rgba(26,26,26,0.85)] hover:scale-105 transition-transform" />`
    ).join('');

    root.innerHTML = `
      <div class="text-center py-6 animate-pop-in">
        <div class="text-7xl md:text-8xl mb-3 sticker-emoji animate-wobble inline-block">${rank.emoji}</div>
        <div class="inline-block rounded-full bg-sun border-4 border-ink px-5 py-2 text-2xl md:text-3xl font-extrabold text-ink shadow-chunky -rotate-2 mb-3">${rank.title}</div>
        <p class="text-base md:text-lg text-ink/80 mb-2">${rank.tagline}</p>
        <div class="my-4">
          <div class="inline-block rounded-2xl bg-lime border-4 border-ink px-6 py-3 text-3xl md:text-4xl font-extrabold text-ink shadow-chunky">
            🌟 ${score.toLocaleString()} silly pts
          </div>
        </div>
        <p class="text-sm md:text-base text-ink/70 mb-6">
          You picked <span class="font-bold text-pink-deep">A: ${aCount}</span> and
          <span class="font-bold text-cyan-deep">B: ${bCount}</span> out of ${game.length}.
        </p>

        <div class="rounded-3xl border-4 border-ink bg-pink p-5 md:p-6 shadow-chunky mb-6 text-left max-w-lg mx-auto">
          <div class="inline-block rounded-full bg-sun border-2 border-ink px-3 py-1 text-xs font-bold mb-3">AD</div>
          <h3 class="text-xl md:text-2xl font-bold text-ink mb-2">You picked ${game.length} times — now pick YOUR case! 📱</h3>
          <p class="text-sm text-ink/85 mb-4">Match your vibe with tough kid phone cases. Unicorn, dinosaur, galaxy & more. Use code <strong>PICKIT15</strong> for 15% off.</p>
          <div class="flex flex-wrap justify-center gap-2 mb-4">${caseGrid}</div>
          <a href="${shopHrefLive}" rel="sponsored nofollow noopener" target="_blank"
             class="block w-full rounded-full bg-cream hover:bg-white border-4 border-ink px-6 py-4 text-xl font-bold text-ink shadow-chunky text-center transition-transform active:translate-x-1 active:translate-y-1">
            Find my case at Phone Cases For Kids →
          </a>
        </div>

        <button id="pickit-replay" class="rounded-full bg-cyan hover:bg-cyan-deep border-4 border-ink px-8 py-4 text-2xl font-bold text-ink shadow-chunky transition-transform active:translate-x-1 active:translate-y-1 active:shadow-chunky-sm">
          🔁 Play another!
        </button>
      </div>
    `;
    document.getElementById('pickit-replay')!.addEventListener('click', () => location.reload());
    burstConfetti();
  }

  function burstConfetti() {
    const pieces = ['🎉','✨','⭐','🌈','🎊','💫','🎈','🍭'];
    for (let i = 0; i < 36; i++) {
      const el = document.createElement('div');
      el.className = 'confetti';
      el.textContent = pieces[Math.floor(Math.random() * pieces.length)]!;
      el.style.left = `${Math.random() * 100}vw`;
      el.style.animationDelay = `${Math.random() * 0.8}s`;
      el.style.animationDuration = `${2.5 + Math.random() * 1.5}s`;
      el.style.fontSize = `${22 + Math.floor(Math.random() * 18)}px`;
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 4500);
    }
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  if (all.length === 0) {
    root.innerHTML = '<div class="text-center text-2xl text-ink/60">No questions loaded yet. Check back soon!</div>';
  } else {
    renderQuestion();
  }
</script>
