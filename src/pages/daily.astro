---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GameRunner from '@/components/GameRunner.astro';
import HeroCaseBar from '@/components/HeroCaseBar.astro';
import KidsCaseAd from '@/components/KidsCaseAd.astro';
import { getEntry } from 'astro:content';
import { adCaseSets, featuredCases } from '@/lib/cases';
import { pcfkHref } from '@/lib/site';

const host = Astro.url.hostname;
const data = await getEntry('games', 'questions');
const allQuestions = data?.data.categories.flatMap(c => c.questions) ?? [];
const sets = adCaseSets();
const featured = featuredCases(6);
const utm = (slot: string) => pcfkHref(slot, host, { game: 'daily' });

// Deterministic "question of the day" from UTC date
const dayKey = new Date().toISOString().slice(0, 10);
let hash = 0;
for (let i = 0; i < dayKey.length; i++) hash = (hash * 31 + dayKey.charCodeAt(i)) >>> 0;
const dailyQ = allQuestions[hash % allQuestions.length]!;
const dailyQuestions = [dailyQ];
---
<BaseLayout
  title="Daily Dilemma — Today's Would You Rather for Kids | Pickit!"
  description="One new silly Would You Rather question every day for kids 9–12. Vote A or B, then come back tomorrow for a fresh dilemma!"
>
  <HeroCaseBar cases={featured} host={host} />

  <header class="text-center mb-6">
    <div class="text-6xl mb-2 sticker-emoji inline-block" aria-hidden="true">📅</div>
    <h1 class="font-display text-4xl md:text-5xl font-bold text-ink mb-2">Daily Dilemma</h1>
    <p class="text-lg text-ink/70 max-w-xl mx-auto">
      One tough silly choice per day. Same question for everyone — come back tomorrow for a new one!
    </p>
    <p class="mt-2 text-sm font-bold text-ink/60">Today: {dayKey}</p>
    <p class="mt-3 text-sm">
      <a href="/" class="font-bold underline decoration-lime decoration-4 underline-offset-4">← 20-question game</a>
      · <a href="/games" class="font-bold underline decoration-cyan decoration-4 underline-offset-4">All games</a>
    </p>
  </header>

  <section class="mb-8 max-w-md mx-auto" aria-label="Sponsored phone case ad">
    <KidsCaseAd
      cases={sets.hero}
      bg="sun"
      headline="Made your pick? Match it with a tough kid case — PICKIT15"
      ctaHref={utm('daily_above')}
      tilt="-1"
    />
  </section>

  <GameRunner
    questions={dailyQuestions}
    perGame={1}
    featuredCases={featured}
    shopHref={utm('daily_post')}
    gameId="daily"
    caseBreakEvery={0}
  />

  <section class="mt-10 text-center max-w-lg mx-auto rounded-3xl border-4 border-ink bg-cyan p-6 shadow-chunky">
    <h2 class="text-2xl font-bold text-ink mb-2">Tomorrow's dilemma drops at midnight</h2>
    <p class="text-ink/80 mb-4">Bookmark this page or play our random 20-question game while you wait.</p>
    <a href="/" class="inline-block rounded-full bg-lime border-4 border-ink px-6 py-3 font-bold text-ink shadow-chunky">🎲 Random 20-question game</a>
  </section>

  <section class="mt-10 max-w-md mx-auto" aria-label="Sponsored phone case ad">
    <KidsCaseAd cases={sets.footer} bg="pink" headline="Cases as bold as your daily pick" ctaHref={utm('daily_footer')} tilt="1" />
  </section>
</BaseLayout>
